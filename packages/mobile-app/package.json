{
  "name": "@codenomad/mobile-app",
  "version": "0.20.0-dev-v2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build && node --import tsx --test tests/browser/*.test.ts",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android:debug": "tauri android build --debug --apk --target aarch64",
    "android:release": "tauri android build --apk --target aarch64",
    "android:bundle": "tauri android build --aab --target aarch64",
    "ios:verify": "node scripts/verify-ios-abi.mjs",
    "ios:init": "npm run ios:verify && tauri ios init",
    "ios:build": "npm run ios:verify && tauri ios build --export-method app-store-connect",
    "rust:policy": "cargo test --manifest-path src-tauri/policy/Cargo.toml",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^22.0.0",
    "playwright": "1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.10"
  }
}
