<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:label="CodeNomad">
        <activity
            android:name="ly.anoma.rune.RuneActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <meta-data
                android:name="ly.anoma.rune.lib_name"
                android:value="main" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="ly.anoma.rune.RuneClipboardProvider"
            android:authorities="${applicationId}.rune.clipboard"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
