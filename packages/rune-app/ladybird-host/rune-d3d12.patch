 use super::*;
 use ::windows::Win32::Foundation::{CloseHandle, GENERIC_ALL, HANDLE};
 use ::windows::Win32::Graphics::Direct3D12::{D3D12_RESOURCE_DIMENSION_TEXTURE2D, ID3D12Device, ID3D12Fence, ID3D12Resource};
-use ::windows::Win32::Graphics::Dxgi::Common::DXGI_FORMAT_B8G8R8A8_UNORM;
+use ::windows::Win32::Graphics::Dxgi::Common::{DXGI_FORMAT_B8G8R8A8_UNORM, DXGI_FORMAT_R8G8B8A8_UNORM};
 use ::windows::core::{HSTRING, Interface};
 use std::sync::atomic::{AtomicU64, Ordering};
 use wgpu::hal::api::Dx12;
+use std::os::windows::io::{AsRawHandle, OwnedHandle};
+
+pub struct LoanedTexture {
+    handle: OwnedHandle,
+    returned: Option<Box<dyn FnOnce() + Send + Sync>>,
+}
+
+impl LoanedTexture {
+    /// # Safety
+    /// `handle` must refer to a D3D12 shared texture in COMMON which has completed all writes.
+    /// The producer must keep it immutable until `returned`. The GPU takes only implicit read promotions.
+    pub unsafe fn new(handle: OwnedHandle, returned: impl FnOnce() + Send + Sync + 'static) -> Self {
+        Self { handle, returned: Some(Box::new(returned)) }
+    }
+
+    pub(crate) fn import(&self, device: &wgpu::Device, [w, h]: [u32; 2]) -> Result<[wgpu::Texture; 2], String> {
+        let hal = unsafe { device.as_hal::<Dx12>() }.ok_or("shared textures require DX12")?;
+        let mut resource: Option<ID3D12Resource> = None;
+        unsafe { hal.raw_device().OpenSharedHandle(HANDLE(self.handle.as_raw_handle()), &mut resource) }
+            .map_err(|e| format!("open loaned D3D12 texture: {e}"))?;
+        let resource = resource.ok_or("missing D3D12 resource")?;
+        drop(hal);
+        let raw = unsafe { resource.GetDesc() };
+        use ::windows::Win32::Graphics::Direct3D12::D3D12_RESOURCE_FLAG_ALLOW_SIMULTANEOUS_ACCESS;
+        if raw.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || raw.Width < u64::from(w) ||
+            raw.Width > u64::from(device.limits().max_texture_dimension_2d) ||
+            raw.Height < h || raw.Height > device.limits().max_texture_dimension_2d ||
+            raw.DepthOrArraySize != 1 || raw.MipLevels != 1 || raw.SampleDesc.Count != 1 ||
+            !raw.Flags.contains(D3D12_RESOURCE_FLAG_ALLOW_SIMULTANEOUS_ACCESS) {
+            return Err("unexpected loaned texture descriptor".into());
+        }
+        let format = match raw.Format {
+            DXGI_FORMAT_R8G8B8A8_UNORM => wgpu::TextureFormat::Rgba8Unorm,
+            DXGI_FORMAT_B8G8R8A8_UNORM => wgpu::TextureFormat::Bgra8Unorm,
+            _ => return Err("unexpected loaned texture format".into()),
+        };
+        let desc = pipeline::descriptor(raw.Width as u32, raw.Height, format);
+        // This matches the video plane import: simultaneous-access resources decay to COMMON
+        // after a submission and implicitly promote to a shader read state at the next draw.
+        let hal = unsafe { wgpu::hal::dx12::Device::texture_from_raw(resource, format, desc.dimension, desc.size, 1, 1) };
+        let texture = unsafe { device.create_texture_from_hal::<Dx12>(hal, &desc, wgpu::TextureUses::RESOURCE) };
+        Ok([texture.clone(), texture])
+    }
+}
+
+impl Drop for LoanedTexture {
+    fn drop(&mut self) {
+        if let Some(returned) = self.returned.take() {
+            returned();
+        }
+    }
+}
 
