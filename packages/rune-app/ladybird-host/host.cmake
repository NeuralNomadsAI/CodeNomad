function(add_rune_preview_host)
    if (NOT WIN32 OR NOT LADYBIRD_HEADLESS_ONLY OR NOT HAS_DIRECTX)
        return()
    endif()
    add_executable(RuneLadybird "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/host.cpp")
    target_link_libraries(RuneLadybird PRIVATE LibCore LibGfx LibIPC LibMain LibURL LibWebView LibWebCommon)
    ladybird_windows_bin(RuneLadybird CONSOLE)
endfunction()
cmake_language(DEFER CALL add_rune_preview_host)
