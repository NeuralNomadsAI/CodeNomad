{
  "name": "@codenomad/ui-host-worker",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:manifest": "node ./scripts/build-manifest.mjs",
    "release:ui": "node ./scripts/release-ui.mjs",
    "predev": "npm run build --prefix ../remote-control-protocol",
    "dev": "wrangler dev",
    "predeploy": "npm run build --prefix ../remote-control-protocol",
