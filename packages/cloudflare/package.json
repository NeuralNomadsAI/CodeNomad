    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codenomad/remote-control-protocol": "file:../remote-control-protocol"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
