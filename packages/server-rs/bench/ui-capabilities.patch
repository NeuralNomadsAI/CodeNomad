diff --git a/packages/ui/src/components/instance/shell/right-panel/status-capabilities.ts b/packages/ui/src/components/instance/shell/right-panel/status-capabilities.ts
new file mode 100644
--- /dev/null
+++ b/packages/ui/src/components/instance/shell/right-panel/status-capabilities.ts
@@ -0,0 +1,13 @@
+import { supportsWorkspaceCapability } from "../../../../stores/workspace-capabilities"
+
+const capabilityBySection: Record<string, string> = {
+  "yolo-mode": "yolo",
+  "provider-usage": "provider-usage",
+  "background-processes": "workspace-shells",
+  "plugins": "workspace-plugins",
+}
+
+export function supportsStatusSection(instanceId: string, section: string): boolean {
+  const capability = capabilityBySection[section]
+  return !capability || supportsWorkspaceCapability(instanceId, capability)
+}
