{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "includeTechnical": {
      "default": false,
      "type": "boolean"
    },
    "since": {
      "type": "string"
    },
    "until": {
      "type": "string"
    },
    "limit": {
      "default": 10,
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    }
  },
  "required": [
    "version",
    "query"
  ],
  "additionalProperties": false
}
