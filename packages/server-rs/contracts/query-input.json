{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "query": {
      "default": "",
      "type": "string",
      "maxLength": 200
    },
    "includeTechnical": {
      "default": true,
      "type": "boolean"
    },
    "purpose": {
      "default": "search",
      "type": "string",
      "enum": [
        "search",
        "stats",
        "prune"
      ]
    },
    "cursor": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "additionalProperties": false
}
