{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "blocked"
        },
        "reason": {
          "type": "string",
          "enum": [
            "unavailable",
            "maintenance_required",
            "conflict",
            "not_deletable",
            "unsupported_storage"
          ]
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "outline"
        },
        "entries": {
          "maxItems": 16384,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "type": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant",
                  "system",
                  "synthetic",
                  "skill",
                  "shell",
                  "compaction",
                  "idle",
                  "agent-switched",
                  "model-switched",
                  "location-switched"
                ]
              },
              "tools": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reasoning": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "text": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "toolName": {
                "type": "string",
                "maxLength": 256
              },
              "layout": {
                "type": "string",
                "pattern": "^(?:[RTX]{0,1000}|[RTX]{0,500}-[RTX]{0,500})$"
              },
              "omitted": {
                "type": "object",
                "properties": {
                  "reasoning": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "text": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "continues": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "reasoning",
                  "text",
                  "continues"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "seq",
              "type",
              "tools",
              "reasoning"
            ],
            "additionalProperties": false
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cursor": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "after": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "through": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "after",
                "through"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoints": {
          "maxItems": 512,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "after": {
                "type": "integer",
                "minimum": -1,
                "maximum": 9007199254740991
              },
              "through": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "changed": {
                "type": "boolean"
              }
            },
            "required": [
              "after",
              "through",
              "digest",
              "changed"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "entries",
        "total",
        "cursor",
        "checkpoints"
      ],
      "additionalProperties": false
    }
  ]
}
