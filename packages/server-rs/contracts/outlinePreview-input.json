{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "messageIDs": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  },
  "required": [
    "sessionID",
    "messageIDs"
  ],
  "additionalProperties": false
}
