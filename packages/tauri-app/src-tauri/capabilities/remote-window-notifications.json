{
  "$schema": "https://schema.tauri.app/capabilities.json",
  "identifier": "remote-window-notifications",
  "description": "Grant remote CodeNomad primary windows native notifications, unread badges and their own shutdown acknowledgement.",
  "local": false,
  "remote": {
    "urls": ["http://*:*", "https://*:*"]
  },
  "webviews": ["remote-*"],
  "permissions": [
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "allow-notification-badge-set",
    "allow-client-state-renderer-flushed",
    "allow-notification-permission",
    "allow-notification-show"
  ]
}
