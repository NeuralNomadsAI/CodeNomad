{
  "$schema": "https://schema.tauri.app/capabilities.json",
  "identifier": "remote-window-notifications",
  "description": "Grant remote CodeNomad primary windows access only to native OS notifications and unread icon badges.",
  "local": false,
  "remote": {
    "urls": ["http://*:*", "https://*:*"]
  },
  "webviews": ["remote-*"],
  "permissions": [
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "allow-notification-badge-set"
  ]
}
