{
  "preview": "<!doctype html><main><form>\n      <label>Title <input value=\"Prefilled\"></label>\n      <label>Plan <select><option value=\"custom\">Flexible</option><option value=\"wayfinder\">Exploration</option></select></label>\n      <button id=\"confirm\" type=\"button\">Confirm</button><button>Submit</button><output id=\"result\">Pending</output>\n      <script>document.getElementById('confirm').addEventListener('click', () => {\n        document.getElementById('result').textContent = document.querySelector('input').value + ':' + document.querySelector('select').value\n      }); document.querySelector('input').addEventListener('keydown', event => {\n        document.getElementById('result').textContent = 'Key:' + event.key\n      }); let submitted = 0; document.querySelector('form').addEventListener('submit', event => {\n        event.preventDefault(); document.getElementById('result').textContent = 'Submitted:' + (++submitted) + ':' + document.querySelector('input').value\n      })</script></form></main>",
  "forms": "<!doctype html><html lang=\"en\"><body><main>\n  <label>Title <input id=\"title\" value=\"Prefilled\"></label>\n  <label>Notes <textarea id=\"notes\">Old notes</textarea></label>\n  <div id=\"rich\" contenteditable=\"true\" role=\"textbox\" aria-label=\"Rich\">Old rich</div>\n  <label>Scenario <select id=\"scenario\"><option value=\"custom\">Flexible mission</option><option value=\"wayfinder\">Exploration</option>\n    <option value=\"debug\" disabled>Debugging</option></select></label>\n  <label>Due <input id=\"due\" type=\"date\"></label>\n  <label>Agree <input id=\"agree\" type=\"checkbox\"></label>\n</main><script>\n  window.events = []\n  for (const element of document.querySelectorAll(\"input, textarea, select, [contenteditable]\")) for (const type of [\"input\", \"change\"]) {\n    element.addEventListener(type, () => window.events.push(type + \":\" + element.id + \":\" + (globalThis.__codenomadAutomationDepth || 0)))\n  }\n</script></body></html>",
  "edges": "<!doctype html><html lang=\"en\"><body><main>\n  <label>Outside <input id=\"outside\" value=\"Kept\"></label>\n  <details><summary>More</summary><label>Hidden <input id=\"hidden\"></label></details>\n  <fieldset disabled><label>Locked <input id=\"locked\"></label></fieldset>\n  <label>Mail <input id=\"mail\" type=\"email\" value=\"ab\"></label>\n  <label>Count <input id=\"count\" type=\"number\" value=\"12\"></label>\n  <label>Tint <input id=\"tint\" type=\"color\"></label>\n  <label>Volume <input id=\"volume\" type=\"range\" min=\"0\" max=\"100\" step=\"20\" value=\"40\"></label>\n  <label>Day <input id=\"day\" type=\"date\" value=\"2026-01-02\"></label>\n  <label>Twins <select id=\"twins\"><option value=\"s1\">Same</option><option value=\"s2\">Same</option></select></label>\n  <div id=\"story\" contenteditable=\"true\" role=\"textbox\" aria-label=\"Story\"><div>one</div><div>two</div></div>\n  <section aria-label=\"Mission editor\"><p>Mission</p></section>\n  <dialog id=\"modal\"><label>Modal field <input id=\"modal-field\"></label></dialog>\n</main><script>\n  window.events = []\n  for (const element of document.querySelectorAll(\"input\")) for (const type of [\"input\", \"change\"]) element.addEventListener(type, () => window.events.push(type + \":\" + element.id))\n</script></body></html>",
  "inputs": "<!doctype html><html lang=\"en\"><body style=\"margin:0\"><main>\n  <form id=\"search\"><label>Query <input id=\"query\"></label><button>Go</button></form>\n  <button id=\"hover-target\">Hover me</button><output id=\"hover-state\">idle</output>\n  <button id=\"menu-trigger\" aria-haspopup=\"menu\">Open menu</button><div id=\"menu\" role=\"menu\" hidden><button role=\"menuitem\" id=\"item\">Menu item</button></div>\n  <div id=\"scroller\" role=\"region\" aria-label=\"Scroller\" style=\"height:100px;overflow:auto\"><div style=\"height:2000px\">tall</div></div>\n  <div style=\"position:relative;height:200px\">\n    <div id=\"handle\" role=\"button\" aria-label=\"Handle\" style=\"position:absolute;left:20px;top:20px;width:40px;height:40px;background:#888\"></div>\n    <div id=\"zone\" role=\"region\" aria-label=\"Drop zone\" style=\"position:absolute;left:300px;top:20px;width:100px;height:100px;border:1px solid\"></div>\n  </div>\n  <div style=\"position:relative\"><button id=\"under\">Under</button>\n    <div id=\"cover\" style=\"position:absolute;inset:0;background:#fff8\" aria-label=\"Cover\"></div></div>\n  <p id=\"later\"></p>\n</main><script>\n  const marked = () => Boolean(globalThis.__codenomadAutomationDepth) || (globalThis.__codenomadAutomationInputUntil || 0) >= performance.now()\n  window.log = []\n  for (const type of [\"keydown\", \"pointerdown\", \"click\"]) document.addEventListener(type, event => {\n    window.log.push(type + \":\" + (event.target.id || event.target.tagName) + \":\" + (event.key || \"\") + \":\" + event.isTrusted + \":\" + marked())\n  }, true)\n  document.getElementById(\"search\").addEventListener(\"submit\", event => { event.preventDefault(); window.log.push(\"submit:\" + query.value) })\n  document.getElementById(\"hover-target\").addEventListener(\"pointerenter\", () => { document.getElementById(\"hover-state\").textContent = \"hovered\" })\n  // Opens on pointerdown only, like Kobalte menus: a programmatic click never opens it.\n  document.getElementById(\"menu-trigger\").addEventListener(\"pointerdown\", () => { document.getElementById(\"menu\").hidden = false })\n  document.getElementById(\"item\").addEventListener(\"click\", () => window.log.push(\"menu-item\"))\n  let dragging = false\n  const handle = document.getElementById(\"handle\"), zone = document.getElementById(\"zone\")\n  handle.addEventListener(\"pointerdown\", event => { dragging = true; handle.setPointerCapture(event.pointerId) })\n  handle.addEventListener(\"pointermove\", event => { if (dragging) { handle.style.left = (event.clientX - 20) + \"px\"; handle.style.top = (event.clientY - handle.offsetParent.getBoundingClientRect().top - 20) + \"px\" } })\n  handle.addEventListener(\"pointerup\", event => {\n    dragging = false\n    const box = zone.getBoundingClientRect()\n    window.dropped = event.clientX >= box.left && event.clientX <= box.right && event.clientY >= box.top && event.clientY <= box.bottom\n  })\n  setTimeout(() => { document.getElementById(\"later\").textContent = \"Ready now\" }, 600)\n</script></body></html>"
