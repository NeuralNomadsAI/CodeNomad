{
  "name": "@neuralnomads/codenomad",
  "version": "1.1.0",
  "description": "CodeNomad Server",
  "license": "MIT",
  "author": {
    "name": "Neural Nomads",
    "email": "codenomad@neuralnomads.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NeuralNomadsAI/CodeNomad.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codenomad": "dist/bin.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:ui && npm run prepare-ui && tsc -p tsconfig.json && node ./scripts/copy-auth-pages.mjs && npm run build:pruning && npm run build:automation && npm run build:missions && npm run build:memory && npm run build:host-helpers && npm run build:remote-tunnel",
    "build:pruning": "node ./scripts/build-session-pruning.mjs",
    "build:automation": "node ./scripts/build-automation-plugin.mjs",
    "build:missions": "node ./scripts/build-missions-plugin.mjs",
    "build:memory": "node ./scripts/build-memory-plugin.mjs",
    "build:host-helpers": "node ./scripts/build-host-helpers.mjs",
    "build:remote-tunnel": "node ./scripts/build-remote-tunnel.mjs",
    "build:ui": "npm run build --prefix ../ui",
    "prepare-ui": "node ./scripts/copy-ui-dist.mjs",
    "dev": "npm run build:pruning && npm run build:automation && npm run build:missions && npm run build:memory && npm run build:host-helpers && cross-env CODENOMAD_DEV=1 CODENOMAD_SERVER_PASSWORD=codenomad-dev CLI_UI_DEV_SERVER=http://localhost:3000 CLI_HTTPS=false CLI_HTTP=true tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/reply-from": "^12.8.1",
    "@fastify/static": "^10.1.10",
    "@opencode/client": "2.2.3",
    "@opencode/schema": "2.2.3",
    "commander": "^12.1.0",
    "dom-accessibility-api": "0.7.1",
    "effect": "4.0.6",
    "fastify": "^5.12.8",
    "fuzzysort": "^2.0.4",
    "jsonc-parser": "^3.3.1",
    "node-forge": "^1.3.3",
    "npm-package-arg": "^13.0.2",
    "openai": "^6.27.0",
    "pino": "^9.4.0",
    "undici": "^6.29.1",
    "yaml": "^2.9.1",
    "yauzl": "^2.10.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@codenomad/remote-tunnel": "file:../remote-tunnel",
    "@opencode/plugin": "2.2.3",
    "@types/node-forge": "^1.3.14",
    "@types/npm-package-arg": "^6.1.4",
    "@types/yauzl": "^2.10.0",
    "ajv2020": "npm:ajv@^8.20.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
