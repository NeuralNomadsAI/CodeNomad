<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "tauri-app-exe": the Tauri application
     executable, signed before the NSIS installer packages it. The submitted
     GitHub artifact is a ZIP holding only this file. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="codenomad-tauri.exe" product-name="CodeNomad" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
